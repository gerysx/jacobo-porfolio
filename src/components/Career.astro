---
import { EXPERIENCE, CERTIFICATIONS, EDUCATION } from "../data/profile"
---

<section id="trayectoria" class="container-x py-24 lg:py-32">
  <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Trayectoria</p>
      <h2 data-split class="h-display text-4xl leading-tight sm:text-5xl">De la atención al cliente a la <span class="italic-gold">gestión de patrimonios</span>.</h2>
    </div>
    <a href="/CV_Jacobo_Alvarez.pdf" download class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-3 text-sm font-medium transition hover:border-ink">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M6 11l6 6 6-6M5 21h14"/></svg>
      Descargar CV
    </a>
  </div>

  <ol data-timeline class="relative ml-2 border-l border-line pl-8 sm:ml-4 sm:pl-12">
    <span data-timeline-bar aria-hidden="true" class="absolute -left-px top-0 h-full w-px bg-gold"></span>
    {EXPERIENCE.map((e, i) => (
      <li class="reveal relative pb-14 last:pb-0">
        <span class:list={["absolute -left-[39px] top-1.5 h-3.5 w-3.5 rounded-full border-2 sm:-left-[55px]", i === 0 ? "border-gold bg-gold shadow-[0_0_0_6px_rgb(var(--gold)/0.2)]" : "border-gold bg-paper"]}></span>
        <div class="grid gap-4 md:grid-cols-[220px_1fr]">
          <div>
            <p class="text-sm tabular-nums text-muted">{e.period}</p>
            <p class="mt-1 font-serif text-2xl">{e.company}</p>
            <p class="text-sm text-muted">{e.location}</p>
          </div>
          <div>
            <h3 class="text-xl font-medium">{e.role}</h3>
            <ul class="mt-3 space-y-2 text-muted">
              {e.points.map((p) => (
                <li class="flex gap-3"><span class="mt-2.5 h-1 w-3 shrink-0 bg-gold/60"></span><span>{p}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<section id="formacion" class="border-t border-line bg-pine py-24 text-paper dark:bg-card dark:text-ink lg:py-32">
  <div class="container-x grid gap-14 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <p class="eyebrow mb-4">Formación y certificaciones</p>
      <h2 data-split class="h-display text-4xl leading-tight sm:text-5xl">Acreditado para <span class="italic text-gold">asesorar</span>.</h2>
      <p class="mt-6 max-w-sm text-paper/70 dark:text-muted">Certificaciones exigidas por MiFID II para informar y asesorar sobre inversión, más formación continua en análisis financiero.</p>
    </div>
    <div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {CERTIFICATIONS.map((c) => (
          <li class="reveal rounded-xl border border-paper/15 p-5 transition hover:border-gold dark:border-line">
            <p class="font-medium leading-snug">{c.title}</p>
            <p class="mt-1 text-sm text-paper/60 dark:text-muted">{c.by}</p>
          </li>
        ))}
      </ul>
      <ul class="mt-8 divide-y divide-paper/15 border-t border-paper/15 dark:divide-line dark:border-line">
        {EDUCATION.map((e) => (
          <li class="reveal flex flex-wrap items-baseline justify-between gap-2 py-5">
            <div>
              <p class="font-serif text-xl">{e.title}</p>
              <p class="text-sm text-paper/60 dark:text-muted">{e.by}</p>
            </div>
            <p class="text-sm tabular-nums text-paper/60 dark:text-muted">{e.period}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
