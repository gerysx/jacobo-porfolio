---
import { EXPERIENCE, CERTIFICATIONS, EDUCATION } from "../data/profile"
---

<section id="trayectoria" class="container-x py-24 lg:py-28">
  <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Trayectoria</p>
      <h2 data-split class="h-section">Más de tres años en banca personal y patrimonial.</h2>
    </div>
    <a href="/CV_Jacobo_Alvarez.pdf" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-line px-4 py-2.5 text-sm font-semibold transition hover:border-ink">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M6 11l6 6 6-6M5 21h14"/></svg>
      Descargar CV (PDF)
    </a>
  </div>

  <ol data-timeline class="relative ml-1.5 border-l border-line pl-8 sm:pl-12">
    <span data-timeline-bar aria-hidden="true" class="absolute -left-px top-0 h-full w-px bg-accent"></span>
    {EXPERIENCE.map((e, i) => (
      <li class="reveal relative pb-12 last:pb-0">
        <span class:list={["absolute -left-[38px] top-1.5 h-3 w-3 rounded-full border-2 border-accent sm:-left-[54px]", i === 0 ? "bg-accent shadow-[0_0_0_5px_rgb(var(--accent)/0.15)]" : "bg-paper"]}></span>
        <div class="grid gap-3 md:grid-cols-[220px_1fr]">
          <div>
            <p class="text-sm text-muted tabular">{e.period}</p>
            <p class="mt-1 text-xl font-semibold tracking-tight text-ink">{e.company}</p>
            <p class="text-sm text-muted">{e.location}</p>
          </div>
          <div class="card p-6">
            <h3 class="text-lg font-semibold text-ink">{e.role}</h3>
            <ul class="mt-3 space-y-2 text-[15px] text-muted">
              {e.points.map((p) => (
                <li class="flex gap-3"><span class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-accent"></span><span>{p}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<section id="formacion" class="relative overflow-hidden bg-navy-900 py-24 text-white lg:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute -right-40 top-0 h-96 w-96 rounded-full bg-[#2a4f86]/50 blur-3xl"></div>
  <div class="container-x relative grid gap-14 lg:grid-cols-[1fr_1.7fr]">
    <div>
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-gold">Formación y certificaciones</p>
      <h2 data-split class="text-3xl font-semibold leading-[1.1] tracking-[-0.03em] sm:text-[2.6rem]">Acreditado para asesorar en inversión.</h2>
      <p class="mt-5 max-w-sm text-white/65">Certificaciones exigidas por MiFID II para informar y asesorar, y formación continua en análisis financiero.</p>
    </div>
    <div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {CERTIFICATIONS.map((c) => (
          <li class="reveal rounded-xl border border-white/12 bg-white/[0.03] p-5 transition hover:border-gold/60">
            <p class="font-medium leading-snug">{c.title}</p>
            <p class="mt-1 text-sm text-white/55">{c.by}</p>
          </li>
        ))}
      </ul>
      <ul class="mt-8 divide-y divide-white/12 border-t border-white/12">
        {EDUCATION.map((e) => (
          <li class="reveal flex flex-wrap items-baseline justify-between gap-2 py-5">
            <div>
              <p class="text-lg font-semibold">{e.title}</p>
              <p class="text-sm text-white/55">{e.by}</p>
            </div>
            <p class="text-sm text-white/55 tabular">{e.period}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
