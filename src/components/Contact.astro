---
import { PROFILE } from "../data/profile"

// El formulario prepara el email con los datos y lo abre en el correo del visitante,
// con Jacobo como destinatario. Sin servidores ni claves.
---

<section id="contacto" class="relative overflow-hidden py-24 lg:py-32">
  <div aria-hidden="true" class="pointer-events-none absolute -left-40 bottom-0 h-[480px] w-[480px] rounded-full bg-gold/10 blur-3xl"></div>
  <div class="container-x grid gap-14 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <p class="eyebrow mb-4">Contacto</p>
      <h2 data-split class="h-display text-4xl leading-tight sm:text-6xl">¿Hablamos de tu <span class="italic-gold">patrimonio</span>?</h2>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-muted">
        Cuéntame brevemente qué buscas y te respondo en menos de 48 horas para concertar una primera conversación, sin compromiso.
      </p>
      <ul class="mt-10 space-y-4">
        <li>
          <a href={`mailto:${PROFILE.email}`} class="group flex items-center gap-4">
            <span class="grid h-11 w-11 place-items-center rounded-full border border-line transition group-hover:border-gold group-hover:text-gold">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <span><span class="block text-sm text-muted">Email</span>{PROFILE.email}</span>
          </a>
        </li>
        <li>
          <a href={PROFILE.linkedin} target="_blank" rel="noopener" class="group flex items-center gap-4">
            <span class="grid h-11 w-11 place-items-center rounded-full border border-line transition group-hover:border-gold group-hover:text-gold">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.6 8.65 21 11.2 21 14.5V21h-4v-5.8c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.5-2.25 3.1V21H9z"/></svg>
            </span>
            <span><span class="block text-sm text-muted">LinkedIn</span>Jacobo Álvarez</span>
          </a>
        </li>
        <li class="flex items-center gap-4">
          <span class="grid h-11 w-11 place-items-center rounded-full border border-line">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          </span>
          <span><span class="block text-sm text-muted">Ubicación</span>{PROFILE.location}, España</span>
        </li>
      </ul>
    </div>

    <form id="contact-form" data-email={PROFILE.email} class="reveal card space-y-5 p-6 shadow-[0_30px_80px_-40px_rgb(var(--pine)/0.4)] sm:p-9" novalidate>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Nombre *</span>
          <input name="nombre" required autocomplete="name" class="field" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Teléfono</span>
          <input name="telefono" type="tel" autocomplete="tel" class="field" />
        </label>
      </div>
      <label class="block">
        <span class="mb-1.5 block text-sm font-medium">Email *</span>
        <input name="email" type="email" required autocomplete="email" class="field" />
      </label>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">¿Qué te interesa?</span>
          <select name="interes" class="field">
            <option>Gestión y seguimiento de cartera</option>
            <option>Fondos de inversión</option>
            <option>Planes de pensiones y jubilación</option>
            <option>Hipoteca o financiación</option>
            <option>Otro</option>
          </select>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Patrimonio aproximado</span>
          <select name="patrimonio" class="field">
            <option>Prefiero no decirlo</option>
            <option>Menos de 100.000 €</option>
            <option>100.000 € – 300.000 €</option>
            <option>300.000 € – 1.000.000 €</option>
            <option>Más de 1.000.000 €</option>
          </select>
        </label>
      </div>
      <label class="block">
        <span class="mb-1.5 block text-sm font-medium">Mensaje *</span>
        <textarea name="mensaje" required rows="4" class="field resize-y" placeholder="Cuéntame tu situación y qué te gustaría conseguir."></textarea>
      </label>
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
      <label class="flex items-start gap-3 text-sm text-muted">
        <input type="checkbox" name="privacidad" required class="mt-0.5 h-4 w-4 accent-[rgb(var(--gold))]" />
        <span>Acepto que mis datos se usen solo para responder a esta consulta. No se cederán a terceros.</span>
      </label>
      <button type="submit" class="group flex w-full items-center justify-center gap-2 rounded-full bg-pine px-6 py-4 font-medium text-paper transition hover:bg-gold disabled:opacity-60 dark:bg-gold dark:hover:bg-ink">
        <span>Enviar por email</span>
        <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
      <p data-status role="status" class="min-h-[1.25rem] text-center text-sm"></p>
    </form>
  </div>
</section>

<style>
  .field {
    @apply w-full rounded-xl border border-line bg-paper px-4 py-3 text-ink outline-none transition placeholder:text-muted/70 focus:border-gold focus:ring-4 focus:ring-gold/15;
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null
  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]")!
    form.addEventListener("submit", (ev) => {
      ev.preventDefault()
      if (!form.checkValidity()) {
        form.reportValidity()
        return
      }
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>
      if (data.botcheck) return
      const body = [
        data.mensaje,
        "",
        `Nombre: ${data.nombre}`,
        `Email: ${data.email}`,
        `Teléfono: ${data.telefono || "-"}`,
        `Interés: ${data.interes}`,
        `Patrimonio aproximado: ${data.patrimonio}`,
      ].join("\n")
      const subject = `Contacto web: ${data.interes} · ${data.nombre}`
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
      status.textContent = "Se ha abierto tu correo con el mensaje preparado. Solo tienes que enviarlo."
      status.style.color = "rgb(var(--pine))"
    })
  }
</script>
