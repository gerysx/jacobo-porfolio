---
import { PROFILE } from "../data/profile"
import { quotes, fmt, pct } from "../lib/markets"

interface Props {
  base?: string
}
const { base = "" } = Astro.props

const links = [
  { href: `${base}#perfil`, label: "Perfil" },
  { href: `${base}#mercados`, label: "Mercados" },
  { href: `${base}#noticias`, label: "Noticias" },
  { href: `${base}#trayectoria`, label: "Trayectoria" },
]
---

<header data-header class="fixed inset-x-0 top-0 z-50">
  {quotes.length > 0 && (
    <div class="overflow-hidden border-b border-white/10 bg-navy-950 text-[12px] text-white/80" aria-label="Cotizaciones al último cierre">
      <div data-marquee class="flex w-max gap-8 whitespace-nowrap py-1.5 tabular">
        {[...quotes, ...quotes].map((q) => (
          <span class="flex items-center gap-2">
            <span class="font-medium text-white">{q.name}</span>
            <span>{fmt(q.last, 2)}</span>
            <span class:list={[q.day >= 0 ? "text-emerald-400" : "text-rose-400"]}>{q.day >= 0 ? "▲" : "▼"} {pct(q.day)}</span>
          </span>
        ))}
      </div>
    </div>
  )}
  <div class="xl:ml-[300px] border-b border-transparent transition-colors duration-300 [.is-scrolled_&]:border-line [.is-scrolled_&]:bg-paper/85 [.is-scrolled_&]:backdrop-blur-md">
    <nav class="container-x flex h-16 items-center justify-between gap-4">
      <a href={`${base}#inicio`} class="flex items-center gap-3">
        <span class="grid h-9 w-9 place-items-center rounded-lg bg-navy-900 text-[13px] font-semibold tracking-tight text-white ring-1 ring-gold/50 [.hero-dark_&]:bg-white/10">JÁ</span>
        <span class="leading-tight">
          <span class="block text-sm font-semibold text-ink [.on-hero_&]:text-white">{PROFILE.name}</span>
          <span class="block text-[11px] text-muted [.on-hero_&]:text-white/60">{PROFILE.role}</span>
        </span>
      </a>
      <ul class="hidden items-center gap-7 text-sm text-muted md:flex [.on-hero_&]:text-white/70">
        {links.map((l) => <li><a href={l.href} class="transition-colors hover:text-ink [.on-hero_&]:hover:text-white">{l.label}</a></li>)}
      </ul>
      <div class="flex items-center gap-2">
        <button id="theme" type="button" aria-label="Cambiar entre tema claro y oscuro" class="grid h-9 w-9 place-items-center rounded-lg border border-line text-muted transition hover:text-ink [.on-hero_&]:border-white/20 [.on-hero_&]:text-white/80">
          <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a href={`${base}#contacto`} class="rounded-lg bg-navy-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-navy-700 dark:bg-white dark:text-navy-900 dark:hover:bg-white/90 [.on-hero_&]:bg-white [.on-hero_&]:text-navy-900">Contacto</a>
      </div>
    </nav>
  </div>
</header>

<script>
  document.getElementById("theme")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark")
    try { localStorage.setItem("theme", dark ? "dark" : "light") } catch {}
  })
  // Mientras la cabecera está sobre la portada azul, texto en blanco
  const header = document.querySelector<HTMLElement>("[data-header]")
  const hero = document.getElementById("inicio")
  const update = () => {
    const y = window.scrollY
    header?.classList.toggle("is-scrolled", y > 40)
    const overHero = !!hero && hero.dataset.dark !== undefined && y < hero.offsetHeight - 80
    header?.classList.toggle("on-hero", overHero && y <= 40)
  }
  update()
  window.addEventListener("scroll", update, { passive: true })
</script>
