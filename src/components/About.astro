---
import { PROFILE, STATS, METHOD, AREAS } from "../data/profile"

const marquee = ["Arquitectura abierta", "Asset allocation", "MiFID II", "Fondos de inversión", "Planes de pensiones", "ESG", "Renta fija", "Renta variable", "PIAS", "Seguros"]
---

<!-- Cifras -->
<section class="border-y border-line bg-card/60">
  <div class="container-x grid grid-cols-2 gap-y-10 py-14 lg:grid-cols-4">
    {STATS.map((s) => (
      <div class="reveal px-2 lg:border-l lg:border-line lg:px-8 first:lg:border-l-0">
        <p class="h-display text-5xl text-ink sm:text-6xl">
          {s.prefix}<span data-count={s.value}>{s.value}</span><span class="text-gold">{s.suffix}</span>
        </p>
        <p class="mt-3 max-w-[16rem] text-sm leading-snug text-muted">{s.label}</p>
      </div>
    ))}
  </div>
</section>

<!-- Sobre mí -->
<section id="sobre-mi" class="container-x grid gap-12 py-24 lg:grid-cols-[1fr_1.4fr] lg:py-32">
  <div>
    <p class="eyebrow mb-4">Sobre mí</p>
    <h2 data-split class="h-display text-4xl leading-tight sm:text-5xl">Una relación de <span class="italic-gold">confianza</span>, no una venta.</h2>
  </div>
  <div class="space-y-5 text-lg leading-relaxed text-muted">
    {PROFILE.summary.map((p) => <p class="reveal">{p}</p>)}
    <p class="reveal text-base">{PROFILE.languages.join(" · ")}</p>
  </div>
</section>

<!-- Cinta -->
<div class="overflow-hidden border-y border-line py-5" aria-hidden="true">
  <div data-marquee class="flex w-max gap-10 whitespace-nowrap font-serif text-2xl italic text-muted/70">
    {[...marquee, ...marquee].map((m) => <span class="flex items-center gap-10">{m}<span class="text-gold not-italic">✦</span></span>)}
  </div>
</div>

<!-- Enfoque -->
<section id="enfoque" class="container-x py-24 lg:py-32">
  <div class="mb-14 max-w-2xl">
    <p class="eyebrow mb-4">Cómo trabajo</p>
    <h2 data-split class="h-display text-4xl leading-tight sm:text-5xl">Cuatro pasos para una cartera que <span class="italic-gold">tiene sentido</span>.</h2>
  </div>
  <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
    {METHOD.map((m) => (
      <li class="reveal card group relative overflow-hidden p-7 transition duration-500 hover:-translate-y-1 hover:border-gold/60">
        <span class="font-serif text-5xl text-gold/40 transition group-hover:text-gold">{m.n}</span>
        <h3 class="mt-6 text-xl font-medium">{m.title}</h3>
        <p class="mt-3 leading-relaxed text-muted">{m.text}</p>
        <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-gold transition duration-500 group-hover:scale-x-100"></span>
      </li>
    ))}
  </ol>

  <div class="mt-20 grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div>
      <p class="eyebrow mb-4">Ámbitos</p>
      <h3 class="h-display text-3xl leading-tight">En qué te puedo ayudar</h3>
    </div>
    <ul class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
      {AREAS.map((a) => (
        <li class="reveal bg-paper p-6 transition hover:bg-card">
          <p class="font-medium">{a.title}</p>
          <p class="mt-1.5 text-sm text-muted">{a.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
