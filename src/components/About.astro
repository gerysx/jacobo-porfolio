---
import { PROFILE, STATS, METHOD, AREAS } from "../data/profile"
---

<!-- Cifras -->
<section class="border-b border-line bg-card">
  <div class="container-x grid grid-cols-2 lg:grid-cols-4">
    {STATS.map((s, i) => (
      <div class:list={["reveal border-line px-4 py-10 sm:px-8", i % 2 === 1 && "border-l", i > 0 && "lg:border-l", i > 1 && "border-t lg:border-t-0"]}>
        <p class="text-4xl font-semibold tracking-[-0.03em] text-ink tabular sm:text-5xl">
          {s.prefix}<span data-count={s.value}>{s.value}</span><span class="text-accent">{s.suffix}</span>
        </p>
        <p class="mt-2 max-w-[15rem] text-sm leading-snug text-muted">{s.label}</p>
      </div>
    ))}
  </div>
</section>

<!-- Perfil -->
<section id="perfil" class="container-x grid gap-12 py-24 lg:grid-cols-[1fr_1.5fr] lg:py-28">
  <div>
    <p class="eyebrow mb-4">Perfil</p>
    <h2 data-split class="h-section">Rigor técnico y trato cercano.</h2>
  </div>
  <div class="space-y-5 text-lg leading-relaxed text-muted">
    {PROFILE.summary.map((p) => <p class="reveal">{p}</p>)}
    <p class="reveal flex flex-wrap gap-2 pt-2 text-sm">
      {PROFILE.languages.map((l) => <span class="rounded-md border border-line bg-card px-2.5 py-1 text-ink">{l}</span>)}
    </p>
  </div>
</section>

<!-- Enfoque -->
<section id="enfoque" class="border-y border-line bg-card py-24 lg:py-28">
  <div class="container-x">
    <div class="mb-12 max-w-2xl">
      <p class="eyebrow mb-4">Enfoque</p>
      <h2 data-split class="h-section">Cómo entiendo una cartera bien construida.</h2>
    </div>
    <ol class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2 lg:grid-cols-4">
      {METHOD.map((m) => (
        <li class="reveal group bg-card p-7 transition-colors hover:bg-paper">
          <span class="text-sm font-semibold text-accent tabular">{m.n}</span>
          <h3 class="mt-4 text-lg font-semibold text-ink">{m.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-muted">{m.text}</p>
        </li>
      ))}
    </ol>

    <div class="mt-16">
      <div>
        <p class="eyebrow mb-3">Especialidades</p>
        <p class="mb-6 text-xl font-semibold tracking-tight text-ink">Competencias en inversión</p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {AREAS.map((a) => (
          <li class="reveal rounded-xl border border-line bg-paper p-5">
            <p class="font-medium text-ink">{a.title}</p>
            <p class="mt-1 text-sm text-muted">{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
