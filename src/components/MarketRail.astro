---
// Panel lateral de mercados (pantallas grandes) y sección de empresas (móvil y tablet).
import stocksData from "../data/stocks.json"
import { quotes, fmt, pct, marketsUpdated } from "../lib/markets"

type Stock = { symbol: string; name: string; last: number; change: number; currency: string; spark: number[] }
const groups = stocksData.groups as Record<string, Stock[]>
const tabs = [
  { id: "es", label: "España" },
  { id: "us", label: "EE. UU." },
].filter((t) => groups[t.id]?.length)

interface Props {
  variant?: "rail" | "section"
}
const { variant = "rail" } = Astro.props

const updatedIso = stocksData.updated ?? marketsUpdated
const updated = updatedIso
  ? new Intl.DateTimeFormat("es-ES", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Europe/Madrid" }).format(new Date(updatedIso))
  : null

const cur = (c: string) => (c === "EUR" ? "€" : c === "USD" ? "$" : "")
function spark(vals: number[], w = 56, h = 20) {
  const min = Math.min(...vals)
  const max = Math.max(...vals)
  return vals.map((v, i) => `${i ? "L" : "M"}${((i / (vals.length - 1)) * w).toFixed(1)} ${(h - 2 - ((v - min) / (max - min || 1)) * (h - 4)).toFixed(1)}`).join(" ")
}
const uid = variant
---

{variant === "rail" ? (
  <aside aria-label="Cotizaciones" class:list={["fixed bottom-0 left-0 z-40 hidden w-[300px] flex-col border-r border-white/10 bg-navy-950 text-white xl:flex", quotes.length ? "top-8" : "top-0"]}>
    <div class="flex h-16 shrink-0 items-center justify-between border-b border-white/10 px-5">
      <p class="text-sm font-semibold">Cotizaciones</p>
      {updated && <p class="text-[11px] text-white/45">{updated}</p>}
    </div>
    <div class="flex-1 overflow-y-auto overscroll-contain" data-lenis-prevent>
      {tabs.length > 0 && (
        <section class="px-5 pb-5 pt-4" data-stocks={uid}>
          <div class="mb-3 flex items-center justify-between">
            <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-gold">Empresas</p>
            <div class="flex gap-1 rounded-md bg-white/5 p-0.5" role="tablist">
              {tabs.map((t, i) => (
                <button role="tab" data-tab={t.id} aria-selected={i === 0 ? "true" : "false"} class="rounded px-2 py-1 text-[11px] font-medium text-white/60 transition aria-selected:bg-white aria-selected:text-navy-900">{t.label}</button>
              ))}
            </div>
          </div>
          {tabs.map((t, i) => (
            <ul data-panel={t.id} class:list={["divide-y divide-white/[0.06] tabular", i > 0 && "hidden"]}>
              {groups[t.id].map((s) => (
                <li class="flex items-center gap-3 py-2.5">
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-[13px] font-medium text-white/90">{s.name}</p>
                    <p class="text-[10px] text-white/40">{s.symbol.replace(".MC", "")}</p>
                  </div>
                  <svg viewBox="0 0 56 20" class="h-5 w-14 shrink-0" aria-hidden="true">
                    <path d={spark(s.spark)} fill="none" stroke-width="1.4" class={s.spark[s.spark.length - 1] >= s.spark[0] ? "stroke-emerald-400" : "stroke-rose-400"}></path>
                  </svg>
                  <div class="w-[72px] text-right">
                    <p class="text-[13px] text-white/85">{`${fmt(s.last, 2)}\u00a0${cur(s.currency)}`}</p>
                    <p class:list={["text-[11px] font-medium", s.change >= 0 ? "text-emerald-400" : "text-rose-400"]}>{pct(s.change)}</p>
                  </div>
                </li>
              ))}
            </ul>
          ))}
        </section>
      )}
    </div>
    <p class="border-t border-white/10 px-5 py-3 text-[10px] leading-snug text-white/40">Datos de Yahoo Finance con retraso. Solo informativos; no son una recomendación.</p>
  </aside>
) : tabs.length > 0 && (
  <section id="empresas" class="pb-24 xl:hidden" data-stocks={uid}>
    <div class="container-x">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-3">Empresas</p>
          <h2 class="text-2xl font-semibold tracking-tight text-ink">Principales cotizadas</h2>
        </div>
        <div class="flex gap-1 rounded-lg border border-line p-1" role="tablist">
          {tabs.map((t, i) => (
            <button role="tab" data-tab={t.id} aria-selected={i === 0 ? "true" : "false"} class="rounded-md px-3 py-1.5 text-xs font-semibold text-muted transition aria-selected:bg-navy-900 aria-selected:text-white dark:aria-selected:bg-white dark:aria-selected:text-navy-900">{t.label}</button>
          ))}
        </div>
      </div>
      {tabs.map((t, i) => (
        <ul data-panel={t.id} class:list={["grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 tabular", i > 0 && "hidden"]}>
          {groups[t.id].map((s) => (
            <li class="flex items-center gap-3 bg-card px-4 py-3">
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium text-ink">{s.name}</p>
                <p class="text-[11px] text-muted">{s.symbol.replace(".MC", "")}</p>
              </div>
              <svg viewBox="0 0 56 20" class="h-5 w-14 shrink-0" aria-hidden="true">
                <path d={spark(s.spark)} fill="none" stroke-width="1.4" class={s.spark[s.spark.length - 1] >= s.spark[0] ? "stroke-up" : "stroke-down"}></path>
              </svg>
              <div class="w-20 text-right">
                <p class="text-sm text-ink">{`${fmt(s.last, 2)}\u00a0${cur(s.currency)}`}</p>
                <p class:list={["text-xs font-medium", s.change >= 0 ? "text-up" : "text-down"]}>{pct(s.change)}</p>
              </div>
            </li>
          ))}
        </ul>
      ))}
      <p class="mt-3 text-xs text-muted">Datos de Yahoo Finance con retraso. Solo informativos; no son una recomendación.</p>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-stocks]").forEach((box) => {
    box.querySelectorAll<HTMLElement>("[data-tab]").forEach((tab) =>
      tab.addEventListener("click", () => {
        box.querySelectorAll("[data-tab]").forEach((t) => t.setAttribute("aria-selected", String(t === tab)))
        box.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== tab.dataset.tab))
      }),
    )
  })
</script>
